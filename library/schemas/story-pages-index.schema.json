{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storyvisualizer.local/schemas/story-pages-index.schema.json",
  "type": "object",
  "required": ["$schema", "by_sequence"],
  "properties": {
    "$schema": { "const": "https://storyvisualizer.local/schemas/story-pages-index.schema.json" },
    "by_sequence": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string", "pattern": "^page-(?:[0-9]{3}|[a-f0-9]{12})$" }
      }
    }
  },
  "additionalProperties": false
}
