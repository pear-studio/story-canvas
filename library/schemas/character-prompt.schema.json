{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storyvisualizer.local/schemas/character-prompt.schema.json",
  "$defs": {
    "variant": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": { "type": "string" },
        "reference_images": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "file", "title"],
            "properties": {
              "id": { "type": "string", "pattern": "^ref-[a-f0-9-]{36}$" },
              "file": { "type": "string", "pattern": "^reference-[a-f0-9-]+\\.png$" },
              "title": { "type": "string", "minLength": 1, "maxLength": 200 }
            }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["$schema", "prompt_name", "variants"],
  "properties": {
    "$schema": { "const": "https://storyvisualizer.local/schemas/character-prompt.schema.json" },
    "prompt_name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "variants": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "not": { "const": "main" }
      },
      "additionalProperties": { "$ref": "#/$defs/variant" }
    }
  },
  "additionalProperties": false
}
