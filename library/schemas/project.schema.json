{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storyvisualizer.local/schemas/project.schema.json",
  "type": "object",
  "required": [
    "format",
    "title",
    "canvas",
    "default_render_profile"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "const": "story-models-v1"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "work_title": {
      "description": "可选作品名称；导出使用对应语言，缺省回退中文作品名、项目 title。",
      "type": "object",
      "properties": {
        "zh": {"type":"string","minLength":1,"maxLength":160},
        "en": {"type":"string","minLength":1,"maxLength":160},
        "ja": {"type":"string","minLength":1,"maxLength":160}
      },
      "additionalProperties": false
    },
    "canvas": {
      "enum": [
        "3:4",
        "1:1",
        "4:3",
        "2:3",
        "9:16"
      ]
    },
    "default_render_profile": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
