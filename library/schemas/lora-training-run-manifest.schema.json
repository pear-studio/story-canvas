{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storyvisualizer.local/schemas/lora-training-run-manifest.schema.json",
  "type": "object",
  "required": [
    "version",
    "id",
    "task_id",
    "dataset_id",
    "created_at",
    "family",
    "prompt_family",
    "task_name",
    "dataset_name",
    "usage_defaults",
    "description",
    "activation_terms",
    "items",
    "groups",
    "models",
    "trainer",
    "recipe",
    "semantic_config",
    "run",
    "sampling",
    "resume",
    "paths",
    "execution",
    "seed"
  ],
  "properties": {
    "version": {
      "const": 5
    },
    "id": {
      "type": "string",
      "pattern": "^run-[a-f0-9]{12}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^(?:lora|dataset)-[a-f0-9]{12}$"
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^dataset-[a-f0-9]{12}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "task_name": {
      "type": "string",
      "minLength": 1
    },
    "dataset_name": {
      "type": "string",
      "minLength": 1
    },
    "family": {
      "const": "qwen-image-2-1"
    },
    "prompt_family": {
      "type": "string",
      "minLength": 1
    },
    "usage_defaults": {
      "$ref": "#/$defs/usage_defaults"
    },
    "description": {
      "type": "string"
    },
    "activation_terms": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/group"
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/model"
      }
    },
    "trainer": {
      "$ref": "#/$defs/trainer"
    },
    "recipe": {
      "$ref": "#/$defs/recipe"
    },
    "semantic_config": {
      "$ref": "#/$defs/semantic_config"
    },
    "run": {
      "$ref": "#/$defs/run"
    },
    "sampling": {
      "$ref": "#/$defs/sampling"
    },
    "resume": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "parent_run_id",
        "source_snapshot_id",
        "source_sha256",
        "start_step"
      ],
      "properties": {
        "parent_run_id": {
          "type": "string",
          "pattern": "^run-[a-f0-9]{12}$"
        },
        "source_snapshot_id": {
          "type": "string",
          "pattern": "^step-[0-9]{6}$"
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "start_step": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "paths": {
      "$ref": "#/$defs/paths"
    },
    "execution": {
      "$ref": "#/$defs/execution"
    },
    "seed": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "safe_relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!\\s)(?!.*\\s$).+$"
    },
    "absolute_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:/|[A-Za-z]:)"
    },
    "usage_defaults": {
      "type": "object",
      "required": [
        "clip_skip",
        "sampler",
        "scheduler",
        "steps",
        "cfg"
      ],
      "properties": {
        "clip_skip": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "sampler": {
          "type": "string",
          "minLength": 1
        },
        "scheduler": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "integer",
          "minimum": 1
        },
        "cfg": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "item": {
      "type": "object",
      "required": [
        "item_id",
        "asset_id",
        "group_id",
        "source_file",
        "image_file",
        "caption_file",
        "image_sha256",
        "caption_sha256"
      ],
      "properties": {
        "item_id": {
          "type": "string",
          "pattern": "^item-[a-f0-9]{12}$"
        },
        "asset_id": {
          "type": "string",
          "pattern": "^(?:asset-[a-f0-9]{12}|[a-z][a-z0-9]*(?:-[a-z0-9]+)*-[0-9]{3})$"
        },
        "group_id": {
          "type": "string",
          "pattern": "^group-[a-f0-9]{12}$"
        },
        "source_file": {
          "$ref": "#/$defs/safe_relative_path"
        },
        "image_file": {
          "$ref": "#/$defs/safe_relative_path"
        },
        "caption_file": {
          "$ref": "#/$defs/safe_relative_path"
        },
        "image_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "caption_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "group": {
      "type": "object",
      "required": [
        "id",
        "name",
        "enabled",
        "repeats"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^group-[a-f0-9]{12}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "enabled": {
          "type": "boolean"
        },
        "repeats": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "required": [
        "kind",
        "relative_path",
        "sha256",
        "size_bytes",
        "source"
      ],
      "properties": {
        "kind": {
          "enum": [
            "dit",
            "text_encoder",
            "vae",
            "processor"
          ]
        },
        "relative_path": {
          "$ref": "#/$defs/safe_relative_path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "source": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "trainer": {
      "type": "object",
      "required": [
        "diffsynth_commit",
        "python",
        "torch",
        "gpu",
        "vram_bytes",
        "runner"
      ],
      "properties": {
        "diffsynth_commit": {
          "type": "string",
          "minLength": 1
        },
        "python": {
          "type": "string",
          "minLength": 1
        },
        "torch": {
          "type": "string",
          "minLength": 1
        },
        "gpu": {
          "type": [
            "string",
            "null"
          ]
        },
        "vram_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "runner": {
          "type": "object",
          "required": [
            "name",
            "version",
            "sha256"
          ],
          "properties": {
            "name": {
              "const": "qwen-image21-lora-runner"
            },
            "version": {
              "type": "integer",
              "minimum": 1
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "recipe": {
      "type": "object",
      "required": [
        "id",
        "version",
        "sha256",
        "overrides"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "overrides": {
          "$ref": "#/$defs/recipe_overrides"
        }
      },
      "additionalProperties": false
    },
    "recipe_overrides": {
      "type": "object",
      "properties": {
        "network_dim": {
          "type": "integer",
          "minimum": 1
        },
        "learning_rate": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "gradient_accumulation_steps": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "semantic_config": {
      "type": "object",
      "required": [
        "max_pixels",
        "network_dim",
        "network_alpha",
        "learning_rate",
        "gradient_accumulation_steps",
        "micro_batch_size",
        "optimizer",
        "scheduler",
        "precision",
        "gradient_checkpointing",
        "lora_target_modules"
      ],
      "properties": {
        "max_pixels": {
          "type": "integer",
          "minimum": 1
        },
        "network_dim": {
          "type": "integer",
          "minimum": 1
        },
        "network_alpha": {
          "type": "integer",
          "minimum": 1
        },
        "learning_rate": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "gradient_accumulation_steps": {
          "type": "integer",
          "minimum": 1
        },
        "micro_batch_size": {
          "const": 1
        },
        "optimizer": {
          "type": "object",
          "required": [
            "type",
            "betas",
            "eps",
            "weight_decay"
          ],
          "properties": {
            "type": {
              "type": "string",
              "minLength": 1
            },
            "betas": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              }
            },
            "eps": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "weight_decay": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "scheduler": {
          "type": "object",
          "required": [
            "type",
            "factor",
            "total_iters"
          ],
          "properties": {
            "type": {
              "type": "string",
              "minLength": 1
            },
            "factor": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "total_iters": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "precision": {
          "type": "object",
          "required": [
            "base",
            "lora",
            "optimizer_state"
          ],
          "properties": {
            "base": {
              "type": "string",
              "minLength": 1
            },
            "lora": {
              "type": "string",
              "minLength": 1
            },
            "optimizer_state": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "gradient_checkpointing": {
          "type": "boolean"
        },
        "lora_target_modules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "required": [
        "max_train_steps",
        "save_every_n_steps",
        "seed"
      ],
      "properties": {
        "note": {
          "type": "string"
        },
        "max_train_steps": {
          "type": "integer",
          "minimum": 1
        },
        "save_every_n_steps": {
          "type": "integer",
          "minimum": 1
        },
        "seed": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "sampling": {
      "type": "object",
      "required": [
        "weights"
      ],
      "properties": {
        "weights": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "item_id",
              "weight"
            ],
            "properties": {
              "item_id": {
                "type": "string",
                "pattern": "^item-[a-f0-9]{12}$"
              },
              "weight": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "paths": {
      "type": "object",
      "required": [
        "inputs_dir",
        "cache_dir",
        "control_dir",
        "archive_dir",
        "resume_dir",
        "events_file",
        "log_file",
        "checkpoints_dir",
        "checkpoints_relative_path",
        "models_root"
      ],
      "properties": {
        "inputs_dir": {
          "$ref": "#/$defs/absolute_path"
        },
        "cache_dir": {
          "$ref": "#/$defs/absolute_path"
        },
        "control_dir": {
          "$ref": "#/$defs/absolute_path"
        },
        "archive_dir": {
          "$ref": "#/$defs/absolute_path"
        },
        "resume_dir": {
          "$ref": "#/$defs/absolute_path"
        },
        "events_file": {
          "$ref": "#/$defs/absolute_path"
        },
        "log_file": {
          "$ref": "#/$defs/absolute_path"
        },
        "checkpoints_dir": {
          "$ref": "#/$defs/absolute_path"
        },
        "checkpoints_relative_path": {
          "$ref": "#/$defs/safe_relative_path"
        },
        "models_root": {
          "$ref": "#/$defs/absolute_path"
        }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": [
        "executable",
        "argv"
      ],
      "properties": {
        "executable": {
          "type": "string",
          "minLength": 1
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  },
  "title": "LoRA 训练 run 冻结清单"
}
