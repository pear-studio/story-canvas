{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storyvisualizer.local/schemas/render-profile.schema.json",
  "$defs": {
    "model": {
      "type": "object",
      "required": [
        "filename",
        "relative_path",
        "sha256"
      ],
      "properties": {
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "relative_path": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "style_lora": {
      "type": "object",
      "required": [
        "filename",
        "sha256",
        "weight"
      ],
      "properties": {
        "filename": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "weight": {
          "type": "number",
          "minimum": -2,
          "maximum": 2
        },
        "trigger": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "route": {
      "type": "object",
      "required": [
        "workflow",
        "recipe"
      ],
      "properties": {
        "workflow": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "recipe": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        }
      },
      "additionalProperties": false
    },
    "candidates": {
      "type": "object",
      "required": [
        "routes"
      ],
      "properties": {
        "routes": {
          "type": "object",
          "required": [
            "empty_latent"
          ],
          "properties": {
            "empty_latent": {
              "$ref": "#/$defs/route"
            },
            "reference_image": {
              "$ref": "#/$defs/route"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "id",
    "name",
    "architecture_family",
    "models",
    "prompt",
    "operations",
    "style_loras"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "architecture_family": {
      "enum": [
        "qwen-image-2-1",
        "anima",
        "minimax-h3"
      ]
    },
    "models": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/model"
      }
    },
    "prompt": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "policy",
            "fragments"
          ],
          "properties": {
            "policy": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            },
            "fragments": {
              "type": "object",
              "propertyNames": {
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "additionalProperties": {
                "$ref": "https://storyvisualizer.local/schemas/prompt-policy.schema.json#/$defs/fragment"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "operations": {
      "type": "object",
      "required": [
        "candidates"
      ],
      "properties": {
        "candidates": {
          "$ref": "#/$defs/candidates"
        }
      },
      "additionalProperties": false
    },
    "style_loras": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/style_lora"
      }
    }
  },
  "allOf": [
    {
      "properties": {
        "models": {
          "required": [
            "dit",
            "text_encoder",
            "vae"
          ],
          "minProperties": 3,
          "maxProperties": 3,
          "propertyNames": {
            "enum": [
              "dit",
              "text_encoder",
              "vae"
            ]
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
