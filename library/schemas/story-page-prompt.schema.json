{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storyvisualizer.local/schemas/story-page-prompt.schema.json",
  "$defs": {
    "overrideSource": {
      "type": "string",
      "pattern": "^(character|scene):[a-z0-9-]+:[a-z0-9-]+$"
    },
    "referenceImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "file", "title"],
      "properties": {
        "id": { "type": "string", "pattern": "^ref-[a-f0-9-]{36}$" },
        "file": { "type": "string", "pattern": "^reference-[a-f0-9-]+\\.png$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    }
  },
  "type": "object",
  "required": ["$schema", "text"],
  "properties": {
    "$schema": { "const": "https://storyvisualizer.local/schemas/story-page-prompt.schema.json" },
    "text": { "type": "string" },
    "scene_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "scene_variant_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "not": { "const": "main" }
    },
    "text_overrides": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/overrideSource" },
      "additionalProperties": { "type": "string" }
    },
    "reference_images": {
      "type": "array",
      "items": { "$ref": "#/$defs/referenceImage" }
    },
    "reference_overrides": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/overrideSource" },
      "additionalProperties": {
        "type": "array",
        "uniqueItems": true,
        "items": { "type": "string", "pattern": "^ref-[a-f0-9-]{36}$" }
      }
    }
  },
  "additionalProperties": false,
  "dependentRequired": {
    "scene_id": ["scene_variant_id"],
    "scene_variant_id": ["scene_id"]
  }
}
