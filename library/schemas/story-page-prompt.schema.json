{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storyvisualizer.local/schemas/story-page-prompt.schema.json",
  "$defs": {
    "fragment": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^token-[0-9a-f]{12}$"
        },
        "tag": {
          "type": "string",
          "pattern": "\\S"
        },
        "description": {
          "type": "string",
          "pattern": "\\S"
        },
        "character_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "weight": {
          "type": "number"
        },
        "enabled": {
          "type": "boolean"
        },
        "camera_settings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "direction",
            "height",
            "shot",
            "view",
            "hands",
            "legs",
            "shadow",
            "perspective",
            "foreshortening",
            "backgroundBlur",
            "foregroundBlur"
          ],
          "properties": {
            "direction": {
              "enum": [
                null,
                "front",
                "side",
                "back"
              ]
            },
            "height": {
              "enum": [
                null,
                "above",
                "below"
              ]
            },
            "shot": {
              "enum": [
                null,
                "特写",
                "近景",
                "中景",
                "全身",
                "远景"
              ]
            },
            "view": {
              "enum": [
                null,
                "pov",
                "female_pov",
                "over_shoulder"
              ]
            },
            "hands": {
              "type": "boolean"
            },
            "legs": {
              "type": "boolean"
            },
            "shadow": {
              "type": "boolean"
            },
            "perspective": {
              "type": "boolean"
            },
            "foreshortening": {
              "type": "boolean"
            },
            "backgroundBlur": {
              "type": "boolean"
            },
            "foregroundBlur": {
              "type": "boolean"
            }
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "tag": true
          },
          "required": [
            "tag"
          ]
        },
        {
          "properties": {
            "description": true
          },
          "required": [
            "description"
          ]
        }
      ],
      "additionalProperties": false
    },
    "fragments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fragment"
      }
    }
  },
  "type": "object",
  "required": [
    "$schema",
    "subject",
    "person",
    "setting",
    "camera",
    "avoid"
  ],
  "properties": {
    "$schema": {
      "const": "https://storyvisualizer.local/schemas/story-page-prompt.schema.json"
    },
    "subject": {
      "$ref": "#/$defs/fragments"
    },
    "person": {
      "$ref": "#/$defs/fragments"
    },
    "setting": {
      "$ref": "#/$defs/fragments"
    },
    "camera": {
      "$ref": "#/$defs/fragments"
    },
    "avoid": {
      "$ref": "#/$defs/fragments"
    },
    "scene_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "inheritance": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(character:[a-z0-9-]+:[a-z0-9-]+|scene:[a-z0-9-]+:[a-z0-9-]+)$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "properties": {
            "weight": {
              "type": "number",
              "minimum": 0.2,
              "maximum": 10
            },
            "enabled": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "scene_variant_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "not": {
        "const": "main"
      }
    },
    "reference_images": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "file",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ref-[a-f0-9-]{36}$"
          },
          "file": {
            "type": "string",
            "pattern": "^reference-[a-f0-9-]+\\.png$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    },
    "reference_overrides": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^ref-[a-f0-9-]{36}$"
        }
      }
    }
  },
  "additionalProperties": false,
  "dependentRequired": {
    "scene_id": [
      "scene_variant_id"
    ],
    "scene_variant_id": [
      "scene_id"
    ]
  }
}
