{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storyvisualizer.local/schemas/story-page-prompt.schema.json",
  "$defs": {
    "fragment": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^token-[0-9a-f]{12}$"
        },
        "tag": {
          "type": "string",
          "pattern": "\\S"
        },
        "description": {
          "type": "string",
          "pattern": "\\S"
        },
        "character_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "weight": {
          "type": "number"
        },
        "enabled": {
          "type": "boolean"
        },
        "camera_settings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "direction",
            "height",
            "shot",
            "view",
            "hands",
            "legs",
            "shadow",
            "perspective",
            "foreshortening",
            "backgroundBlur",
            "foregroundBlur"
          ],
          "properties": {
            "direction": {
              "enum": [
                null,
                "front",
                "side",
                "back"
              ]
            },
            "height": {
              "enum": [
                null,
                "above",
                "below"
              ]
            },
            "shot": {
              "enum": [
                null,
                "特写",
                "近景",
                "中景",
                "全身",
                "远景"
              ]
            },
            "view": {
              "enum": [
                null,
                "pov",
                "female_pov",
                "over_shoulder"
              ]
            },
            "hands": {
              "type": "boolean"
            },
            "legs": {
              "type": "boolean"
            },
            "shadow": {
              "type": "boolean"
            },
            "perspective": {
              "type": "boolean"
            },
            "foreshortening": {
              "type": "boolean"
            },
            "backgroundBlur": {
              "type": "boolean"
            },
            "foregroundBlur": {
              "type": "boolean"
            }
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "tag": true
          },
          "required": [
            "tag"
          ]
        },
        {
          "properties": {
            "description": true
          },
          "required": [
            "description"
          ]
        }
      ],
      "additionalProperties": false
    },
    "fragments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fragment"
      }
    }
  },
  "type": "object",
  "required": [
    "$schema",
    "subject",
    "person",
    "setting",
    "camera",
    "avoid"
  ],
  "properties": {
    "$schema": {
      "const": "https://storyvisualizer.local/schemas/story-page-prompt.schema.json"
    },
    "mode": {
      "enum": [
        "structured",
        "free"
      ]
    },
    "two_step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "strength"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "draft": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "positive",
            "base_sha256"
          ],
          "properties": {
            "positive": {
              "type": "string"
            },
            "base_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      }
    },
    "free": {
      "type": "object",
      "required": [
        "positive",
        "negative",
        "loras",
        "base_sha256"
      ],
      "properties": {
        "positive": {
          "type": "string"
        },
        "negative": {
          "type": "string"
        },
        "loras": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "filename",
              "sha256",
              "weight"
            ],
            "properties": {
              "filename": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "weight": {
                "type": "number",
                "minimum": -2,
                "maximum": 2
              },
              "trigger": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "base_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "subject": {
      "$ref": "#/$defs/fragments"
    },
    "person": {
      "$ref": "#/$defs/fragments"
    },
    "setting": {
      "$ref": "#/$defs/fragments"
    },
    "camera": {
      "$ref": "#/$defs/fragments"
    },
    "avoid": {
      "$ref": "#/$defs/fragments"
    },
    "scene_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "inheritance": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(character:[a-z0-9-]+:[a-z0-9-]+|scene:[a-z0-9-]+:[a-z0-9-]+)$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "properties": {
            "weight": {
              "type": "number",
              "minimum": 0.2,
              "maximum": 10
            },
            "enabled": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "scene_variant_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "not": {
        "const": "main"
      }
    },
    "reference_image": {
      "type": "string",
      "pattern": "^[^/\\\\]+\\.(?:png|jpe?g|webp|PNG|JPE?G|WEBP)$"
    }
  },
  "additionalProperties": false,
  "dependentRequired": {
    "scene_id": [
      "scene_variant_id"
    ],
    "scene_variant_id": [
      "scene_id"
    ]
  }
}
