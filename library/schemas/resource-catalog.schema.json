{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storyvisualizer.local/schemas/resource-catalog.schema.json",
  "type": "object",
  "required": ["version", "models"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "kind", "architecture_family", "filename", "relative_path", "sha256"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["checkpoint", "dit", "text_encoder", "lora", "vae", "embedding", "other"] },
          "architecture_family": { "enum": ["anima", "qwen-image-2-1", "other"] },
          "prompt_family": { "type": "string", "minLength": 1 },
          "filename": { "type": "string", "minLength": 1 },
          "relative_path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "source": { "type": "string", "minLength": 1 },
          "preview": {
            "type": "object",
            "required": ["images"],
            "properties": {
              "images": {
                "type": "array",
                "minItems": 1,
                "maxItems": 10,
                "items": {
                  "type": "object",
                  "required": ["src", "alt"],
                  "properties": {
                    "src": { "type": "string", "pattern": "^/resource-previews/[a-z0-9-]+\\.(jpg|jpeg|png|webp)$" },
                    "alt": { "type": "string", "minLength": 1 },
                    "source": { "type": "string", "minLength": 1 }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
