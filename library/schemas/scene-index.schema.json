{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storyvisualizer.local/schemas/scene-index.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "scenes"
  ],
  "properties": {
    "$schema": {
      "const": "https://storyvisualizer.local/schemas/scene-index.schema.json"
    },
    "scenes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    }
  }
}
