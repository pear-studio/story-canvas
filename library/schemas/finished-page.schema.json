{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storyvisualizer.local/schemas/finished-page.schema.json",
  "type": "object",
  "required": [
    "page_key",
    "lettering",
    "created_at",
    "width",
    "height",
    "outputs"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "page_key": {
      "type": "object",
      "required": [
        "page_id"
      ],
      "properties": {
        "page_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "page_kind": {
      "enum": [
        "text",
        "video",
        "comic",
        "collage"
      ]
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^candidate-"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "generation": {
      "type": "object"
    },
    "lettering": {
      "type": "object",
      "required": [
        "canvas"
      ],
      "properties": {
        "locale": {
          "enum": [
            "en",
            "ja"
          ]
        },
        "source_dialogue": {
          "type": "array"
        },
        "dialogue": {
          "type": "array"
        },
        "items": {
          "type": "array"
        },
        "settings": {
          "type": "object"
        },
        "canvas": {
          "type": "string"
        },
        "page_kind": {
          "enum": [
            "text",
            "video",
            "comic",
            "collage"
          ]
        },
        "display_title": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "text_layout": {
          "$ref": "https://storyvisualizer.local/schemas/story-page-narrative.schema.json#/$defs/text_layout"
        },
        "panels": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "page_id",
              "frame",
              "lettering"
            ],
            "properties": {
              "page_id": {
                "type": "string"
              },
              "frame": {
                "type": "object"
              },
              "lettering": {
                "type": "object"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "upscale": {
      "type": "object",
      "required": [
        "name",
        "sha256",
        "scale",
        "source"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "scale": {
          "const": 2
        },
        "source": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "created_at": {
      "type": "string"
    },
    "width": {
      "type": "integer",
      "minimum": 1
    },
    "height": {
      "type": "integer",
      "minimum": 1
    },
    "outputs": {
      "type": "object",
      "required": [
        "clean",
        "lettered"
      ],
      "properties": {
        "clean": {
          "type": "string",
          "description": "干净底图。新静态成品保存为 Outputs/finished/<page_id>/clean/<SHA-256>.png，同页相同字节由各语言共用；旧独立路径仍可读取，显式归并使用 finished.clean.inspect/share。",
          "pattern": "^Outputs/finished/"
        },
        "lettered": {
          "type": "string",
          "pattern": "^Outputs/finished/"
        },
        "gif": {
          "type": "string",
          "pattern": "^Outputs/finished/.*\\.gif$"
        }
      },
      "additionalProperties": false
    },
    "poster": {
      "type": "string"
    },
    "video": {
      "type": "object"
    },
    "video_postprocess": {
      "$ref": "https://storyvisualizer.local/schemas/story-page-narrative.schema.json#/$defs/video_postprocess"
    },
    "comic": {
      "$ref": "https://storyvisualizer.local/schemas/comic-page.schema.json"
    },
    "comic_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "comic_sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object"
      }
    },
    "media_format": {
      "enum": [
        "webp"
      ]
    },
    "source_video": {
      "type": "object"
    },
    "source_backup": {
      "type": "string",
      "pattern": "^Outputs/finished/"
    },
    "gif": {
      "type": "object",
      "description": "GIF实际尺寸、编码帧数、时长与字节数；encoding记录自动降级结果，旧记录可省略。",
      "properties": {
        "encoding": {
          "type": "object",
          "required": ["policy", "max_bytes", "tier", "max_width", "target_fps", "colors", "original_bytes", "attempts"],
          "properties": {
            "policy": {"type": "string"},
            "max_bytes": {"type": "integer", "minimum": 1},
            "tier": {"type": "integer", "minimum": 0},
            "max_width": {"type": "integer", "minimum": 1},
            "target_fps": {"type": "number", "exclusiveMinimum": 0},
            "colors": {"type": "integer", "minimum": 2, "maximum": 256},
            "original_bytes": {"type": "integer", "minimum": 1},
            "attempts": {"type": "array", "minItems": 1, "items": {"type": "object"}}
          },
          "additionalProperties": false
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "collage": {
      "$ref": "https://storyvisualizer.local/schemas/collage-page.schema.json"
    },
    "collage_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "clean_collage_media_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "去掉导入素材后组图原画来源的指纹"
    },
    "collage_media_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "输出时冻结的组图来源候选指纹，用于判断成品是否过时"
    },
    "layers": {
      "$ref": "page-layers.schema.json"
    },
    "layers_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "page_kind": {
            "const": "video"
          }
        },
        "required": [
          "page_kind"
        ]
      },
      "then": {
        "properties": {
          "upscale": false,
          "lettering": {
            "required": [
              "page_kind"
            ],
            "properties": {
              "page_kind": {
                "const": "video"
              }
            }
          }
        }
      },
      "else": {
        "if": {
          "properties": {
            "page_kind": {
              "const": "comic"
            }
          },
          "required": [
            "page_kind"
          ]
        },
        "then": {
          "properties": {
            "lettering": {
              "required": [
                "page_kind",
                "panels"
              ]
            }
          }
        },
        "else": {
          "properties": {
            "lettering": {
              "required": [
                "settings"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "page_kind": {
            "const": "text"
          }
        },
        "required": [
          "page_kind"
        ]
      },
      "then": {
        "properties": {
          "candidate_id": false,
          "source_sha256": false,
          "generation": false,
          "upscale": false
        }
      },
      "else": {
        "if": {
          "properties": {
            "page_kind": {
              "const": "video"
            }
          },
          "required": [
            "page_kind"
          ]
        },
        "then": {
          "required": [
            "candidate_id",
            "source_sha256",
            "video",
            "poster"
          ]
        },
        "else": {
          "if": {
            "properties": {
              "page_kind": {
                "const": "comic"
              }
            },
            "required": [
              "page_kind"
            ]
          },
          "then": {
            "required": [
              "comic",
              "comic_sha256",
              "comic_sources"
            ],
            "properties": {
              "candidate_id": false,
              "source_sha256": false,
              "generation": false,
              "upscale": false
            }
          },
          "else": {
            "required": [
              "candidate_id",
              "source_sha256",
              "generation",
              "upscale"
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "media_format"
        ]
      },
      "then": {
        "required": [
          "source_video",
          "source_backup",
          "gif",
          "warnings"
        ],
        "properties": {
          "page_kind": {
            "const": "video"
          },
          "outputs": {
            "required": [
              "gif"
            ],
            "properties": {
              "clean": {
                "pattern": "\\.webp$"
              },
              "lettered": {
                "pattern": "\\.webp$"
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
