{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storyvisualizer.local/schemas/page-layers.schema.json",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "assets": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9_-]{1,90}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/asset"
      }
    },
    "items": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,90}$"
          },
          "asset_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,90}$"
          },
          "box": {
            "$ref": "#/$defs/rect"
          },
          "crop": {
            "$ref": "#/$defs/rect"
          },
          "enabled": {
            "type": "boolean",
            "description": "false 保留图片排版，不参与预览、平铺和成品输出"
          }
        },
        "required": [
          "id",
          "asset_id",
          "box",
          "crop",
          "enabled"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "assets",
    "items"
  ],
  "additionalProperties": false,
  "$defs": {
    "rect": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "w": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "exclusiveMinimum": 0
        },
        "h": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^[^<>:\"/\\\\\\\\|?*]+\\.(png|jpe?g|webp|PNG|JPG|JPEG|WEBP)$"
        },
        "multilingual": {"type":"boolean","description":"默认关闭，各语言共用 file；开启后英文和日文使用对应 localizations，不回退中文"},
        "localizations": {
          "type":"object",
          "properties": {
            "en":{"$ref":"#/$defs/localizedFile"},
            "ja":{"$ref":"#/$defs/localizedFile"}
          },
          "additionalProperties":false
        }
      },
      "required": [
        "file"
      ],
      "additionalProperties": false
    },
    "localizedFile": {
      "type":"object",
      "properties":{"file":{"type":"string","pattern":"^[^<>:\"/\\\\|?*]+\\.(png|jpe?g|webp|PNG|JPG|JPEG|WEBP)$"}},
      "required":["file"],
      "additionalProperties":false
    }
  }
}
