{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storyvisualizer.local/schemas/comparison-lora-source.schema.json",
  "description": "对比实验 LoRA 输入声明。identity 是来源声明，不能声明兼容规则；省略 activation 表示未知，显式空数组表示已知无触发词。",
  "type": "object",
  "required": ["id", "kind"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$" },
    "kind": { "enum": ["raw", "resource"] },
    "relative_path": { "type": "string", "pattern": "^loras/(?!.*\\\\)(?!.*\\.\\.).+\\.safetensors$" },
    "resource_id": { "type": "string", "pattern": "^lora-[a-f0-9]{16}$" },
    "identity": {
      "type": "object", "required": ["architecture_family", "base_models", "adapted_components"],
      "properties": {
        "architecture_family": { "enum": ["sd15", "sdxl", "anima", "qwen-image-2-1", "moss-image", "sd3", "flux", "other"] },
        "base_models": { "type": "array", "minItems": 1, "items": { "$ref": "lora-resource.schema.json#/$defs/model" } },
        "adapted_components": { "const": ["dit"] }
      },
      "additionalProperties": false
    },
    "activation": {
      "type": "object", "required": ["trigger_words", "tags"],
      "properties": {
        "trigger_words": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 1024 } },
        "tags": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 1024 } }
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    { "properties": { "kind": { "const": "raw" } }, "required": ["relative_path"], "not": { "required": ["resource_id"] } },
    { "properties": { "kind": { "const": "resource" } }, "required": ["resource_id"], "not": { "required": ["relative_path"] } }
  ],
  "additionalProperties": false
}
