{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storyvisualizer.local/schemas/character-lora.schema.json",
  "$defs": {
    "lora": {
      "type": "object",
      "required": ["filename", "sha256", "weight"],
      "properties": {
        "filename": { "type": "string", "pattern": "^(?!\\s)(?!.*\\s$)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\:]).+$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "weight": { "type": "number", "minimum": -2, "maximum": 2 },
        "trigger": { "type": "string", "pattern": "\\S" }
      },
      "additionalProperties": false
    },
    "loras": {
      "type": "array",
      "items": { "$ref": "#/$defs/lora" }
    }
  },
  "type": "object",
  "required": ["$schema", "identity", "variants"],
  "properties": {
    "$schema": { "const": "https://storyvisualizer.local/schemas/character-lora.schema.json" },
    "identity": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/lora" }
      ]
    },
    "variants": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "not": { "const": "main" }
      },
      "additionalProperties": { "$ref": "#/$defs/loras" },
      "description": "按造型 id 拆分的 loras，至少一个造型。"
    }
  },
  "additionalProperties": false
}
