{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storyvisualizer.local/schemas/workflow-manifest.schema.json",
  "type": "object",
  "required": ["id", "template", "architecture_families", "operations", "input_sources", "modifiers", "bindings"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "template": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*\\.api\\.json$" },
    "architecture_families": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["anima", "qwen-image-2-1"] }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["candidates"] }
    },
    "input_sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["empty_latent", "reference_image"] }
    },
    "modifiers": {
      "type": "array",
      "uniqueItems": true,
      "items": { "const": "lora.model_only" }
    },
    "bindings": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "enum": [
          "dit", "text_encoder", "vae",
          "positive_prompt", "negative_prompt",
          "width", "height",
          "seed", "steps", "cfg", "sampler", "scheduler",
          "final_width", "final_height",
          "second_pass_seed", "second_pass_steps", "second_pass_cfg", "second_pass_sampler", "second_pass_scheduler",
          "denoise", "filename_prefix", "reference_image"
        ]
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^(?!(?:__proto__|prototype|constructor)\\.)[A-Za-z0-9_-]+\\.inputs\\.(?!(?:__proto__|prototype|constructor)$)[A-Za-z0-9_]+$"
      }
    }
  },
  "additionalProperties": false
}
