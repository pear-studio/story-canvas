{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storyvisualizer.local/schemas/render-recipe.schema.json",
  "$defs": {
    "resolution": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 64, "multipleOf": 8 },
        "height": { "type": "integer", "minimum": 64, "multipleOf": 8 }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["id", "name", "resolutions", "steps", "cfg", "sampler", "scheduler", "clip_skip"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "resolutions": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "enum": ["3:4", "2:3", "9:16", "4:3"] },
      "additionalProperties": { "$ref": "#/$defs/resolution" }
    },
    "steps": { "type": "integer", "minimum": 1, "maximum": 100 },
    "cfg": { "type": "number", "exclusiveMinimum": 0, "maximum": 30 },
    "sampler": { "type": "string", "minLength": 1 },
    "scheduler": { "type": "string", "minLength": 1 },
    "clip_skip": { "type": "integer", "minimum": 1, "maximum": 12 },
    "scale": { "type": "number", "minimum": 1, "maximum": 4 },
    "denoise": { "type": "number", "minimum": 0, "maximum": 1 },
    "second_pass_steps": { "type": "integer", "minimum": 1, "maximum": 100 },
    "second_pass_cfg": { "type": "number", "exclusiveMinimum": 0, "maximum": 30 },
    "second_pass_sampler": { "type": "string", "minLength": 1 },
    "second_pass_scheduler": { "type": "string", "minLength": 1 }
  },
  "dependentRequired": {
    "scale": ["denoise", "second_pass_steps", "second_pass_cfg", "second_pass_sampler", "second_pass_scheduler"],
    "denoise": ["scale", "second_pass_steps", "second_pass_cfg", "second_pass_sampler", "second_pass_scheduler"],
    "second_pass_steps": ["scale", "denoise", "second_pass_cfg", "second_pass_sampler", "second_pass_scheduler"],
    "second_pass_cfg": ["scale", "denoise", "second_pass_steps", "second_pass_sampler", "second_pass_scheduler"],
    "second_pass_sampler": ["scale", "denoise", "second_pass_steps", "second_pass_cfg", "second_pass_scheduler"],
    "second_pass_scheduler": ["scale", "denoise", "second_pass_steps", "second_pass_cfg", "second_pass_sampler"]
  },
  "additionalProperties": false
}
