{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storyvisualizer.local/schemas/lora-training-settings.schema.json",
  "title": "训练项目模型设置",
  "description": "v6 每个模型保存一套当前训练配置，引用项目内独立打标集；v5 仅供历史读取与显式迁移。",
  "oneOf": [
    {
      "$ref": "#/$defs/current_settings"
    },
    {
      "$ref": "#/$defs/legacy_settings"
    }
  ],
  "$defs": {
    "usage_defaults": {
      "type": "object",
      "required": [
        "clip_skip",
        "sampler",
        "scheduler",
        "steps",
        "cfg"
      ],
      "properties": {
        "clip_skip": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "sampler": {
          "type": "string",
          "minLength": 1
        },
        "scheduler": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "integer",
          "minimum": 1
        },
        "cfg": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "base_dir": {
      "type": "object",
      "required": [
        "relative_path"
      ],
      "properties": {
        "relative_path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\.\\.)(?!.*\\\\).+/$"
        },
        "source": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "recipe_overrides": {
      "type": "object",
      "required": [
        "network_dim",
        "learning_rate",
        "gradient_accumulation_steps"
      ],
      "properties": {
        "network_dim": {
          "type": "integer",
          "minimum": 1
        },
        "learning_rate": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "gradient_accumulation_steps": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "qwen_base": {
      "type": "object",
      "required": [
        "dit",
        "text_encoder",
        "vae",
        "processor"
      ],
      "properties": {
        "dit": {
          "$ref": "#/$defs/base_dir"
        },
        "text_encoder": {
          "$ref": "#/$defs/base_dir"
        },
        "vae": {
          "$ref": "#/$defs/base_dir"
        },
        "processor": {
          "$ref": "#/$defs/base_dir"
        }
      },
      "additionalProperties": false
    },
    "anima_base": {
      "type": "object",
      "required": [
        "dit",
        "text_encoder",
        "vae"
      ],
      "properties": {
        "dit": {
          "$ref": "#/$defs/base_file"
        },
        "text_encoder": {
          "$ref": "#/$defs/base_file"
        },
        "vae": {
          "$ref": "#/$defs/base_file"
        }
      },
      "additionalProperties": false
    },
    "base_file": {
      "type": "object",
      "required": [
        "relative_path"
      ],
      "properties": {
        "relative_path": {
          "type": "string",
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\.\\.)(?!.*\\\\).+\\.safetensors$"
        },
        "source": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "anima_recipe_overrides": {
      "type": "object",
      "required": [
        "network_dim",
        "learning_rate",
        "gradient_accumulation_steps",
        "micro_batch_size",
        "blocks_to_swap"
      ],
      "properties": {
        "network_dim": {
          "type": "integer",
          "minimum": 1
        },
        "learning_rate": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "gradient_accumulation_steps": {
          "type": "integer",
          "minimum": 1
        },
        "micro_batch_size": {
          "type": "integer",
          "minimum": 1
        },
        "blocks_to_swap": {
          "type": "integer",
          "minimum": 0,
          "maximum": 27
        }
      },
      "additionalProperties": false
    },
    "moss_base": {
      "type": "object",
      "required": [
        "dit",
        "text_encoder",
        "vae",
        "tokenizer"
      ],
      "properties": {
        "dit": {
          "$ref": "#/$defs/base_file"
        },
        "text_encoder": {
          "$ref": "#/$defs/base_dir"
        },
        "vae": {
          "$ref": "#/$defs/base_file"
        },
        "tokenizer": {
          "$ref": "#/$defs/base_dir"
        }
      },
      "additionalProperties": false
    },
    "legacy_settings": {
      "type": "object",
      "required": [
        "version",
        "target",
        "training_recipe",
        "run_defaults"
      ],
      "properties": {
        "version": {
          "const": 5
        },
        "target": {
          "type": "object",
          "required": [
            "family",
            "prompt_family",
            "usage_defaults",
            "base"
          ],
          "properties": {
            "family": {
              "enum": [
                "anima",
                "qwen-image-2-1"
              ]
            },
            "prompt_family": {
              "type": "string",
              "minLength": 1
            },
            "usage_defaults": {
              "$ref": "#/$defs/usage_defaults"
            },
            "base": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "training_recipe": {
          "type": "object",
          "required": [
            "id",
            "overrides"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "overrides": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "run_defaults": {
          "type": "object",
          "required": [
            "max_train_steps",
            "save_every_n_steps",
            "seed"
          ],
          "properties": {
            "max_train_steps": {
              "type": "integer",
              "minimum": 1
            },
            "save_every_n_steps": {
              "type": "integer",
              "minimum": 1
            },
            "seed": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "target": {
                "properties": {
                  "family": {
                    "const": "anima"
                  }
                },
                "required": [
                  "family"
                ],
                "type": "object"
              }
            },
            "required": [
              "target"
            ],
            "type": "object"
          },
          "then": {
            "properties": {
              "target": {
                "properties": {
                  "base": {
                    "$ref": "#/$defs/anima_base"
                  }
                },
                "type": "object"
              },
              "training_recipe": {
                "properties": {
                  "overrides": {
                    "$ref": "#/$defs/anima_recipe_overrides"
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "target": {
                "properties": {
                  "family": {
                    "const": "qwen-image-2-1"
                  }
                },
                "required": [
                  "family"
                ],
                "type": "object"
              }
            },
            "required": [
              "target"
            ],
            "type": "object"
          },
          "then": {
            "properties": {
              "target": {
                "properties": {
                  "base": {
                    "$ref": "#/$defs/qwen_base"
                  }
                },
                "type": "object"
              },
              "training_recipe": {
                "properties": {
                  "overrides": {
                    "$ref": "#/$defs/recipe_overrides"
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          }
        }
      ],
      "description": "只读兼容的旧版设置；修改前须显式迁移。"
    },
    "model_settings": {
      "type": "object",
      "required": [
        "version",
        "target",
        "caption_set_id",
        "training_recipe",
        "run_defaults"
      ],
      "properties": {
        "version": {
          "const": 6
        },
        "target": {
          "type": "object",
          "required": [
            "family",
            "prompt_family",
            "usage_defaults",
            "base"
          ],
          "properties": {
            "family": {
              "enum": [
                "anima",
                "qwen-image-2-1",
                "moss-image"
              ]
            },
            "prompt_family": {
              "type": "string",
              "minLength": 1
            },
            "usage_defaults": {
              "$ref": "#/$defs/usage_defaults"
            },
            "base": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "training_recipe": {
          "type": "object",
          "required": [
            "id",
            "overrides"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "overrides": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "run_defaults": {
          "type": "object",
          "required": [
            "max_train_steps",
            "save_every_n_steps",
            "seed"
          ],
          "properties": {
            "max_train_steps": {
              "type": "integer",
              "minimum": 1
            },
            "save_every_n_steps": {
              "type": "integer",
              "minimum": 1
            },
            "seed": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "caption_set_id": {
          "type": "string",
          "pattern": "^caption-set-[a-f0-9]{12}$"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "target": {
                "properties": {
                  "family": {
                    "const": "anima"
                  }
                },
                "required": [
                  "family"
                ],
                "type": "object"
              }
            },
            "required": [
              "target"
            ],
            "type": "object"
          },
          "then": {
            "properties": {
              "target": {
                "properties": {
                  "base": {
                    "$ref": "#/$defs/anima_base"
                  }
                },
                "type": "object"
              },
              "training_recipe": {
                "properties": {
                  "overrides": {
                    "$ref": "#/$defs/anima_recipe_overrides"
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "target": {
                "properties": {
                  "family": {
                    "const": "qwen-image-2-1"
                  }
                },
                "required": [
                  "family"
                ],
                "type": "object"
              }
            },
            "required": [
              "target"
            ],
            "type": "object"
          },
          "then": {
            "properties": {
              "target": {
                "properties": {
                  "base": {
                    "$ref": "#/$defs/qwen_base"
                  }
                },
                "type": "object"
              },
              "training_recipe": {
                "properties": {
                  "overrides": {
                    "$ref": "#/$defs/recipe_overrides"
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          }
        },
        {
          "type": "object",
          "if": {
            "type": "object",
            "required": [
              "target"
            ],
            "properties": {
              "target": {
                "type": "object",
                "required": [
                  "family"
                ],
                "properties": {
                  "family": {
                    "const": "moss-image"
                  }
                }
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "target": {
                "type": "object",
                "properties": {
                  "base": {
                    "$ref": "#/$defs/moss_base"
                  }
                }
              },
              "training_recipe": {
                "type": "object",
                "properties": {
                  "overrides": {
                    "$ref": "#/$defs/recipe_overrides"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "current_settings": {
      "type": "object",
      "required": [
        "version",
        "models"
      ],
      "properties": {
        "version": {
          "const": 6
        },
        "models": {
          "type": "object",
          "properties": {
            "anima": {
              "allOf": [
                {
                  "$ref": "#/$defs/model_settings"
                },
                {
                  "type": "object",
                  "properties": {
                    "target": {
                      "type": "object",
                      "properties": {
                        "family": {
                          "const": "anima"
                        }
                      }
                    }
                  }
                }
              ]
            },
            "qwen-image-2-1": {
              "allOf": [
                {
                  "$ref": "#/$defs/model_settings"
                },
                {
                  "type": "object",
                  "properties": {
                    "target": {
                      "type": "object",
                      "properties": {
                        "family": {
                          "const": "qwen-image-2-1"
                        }
                      }
                    }
                  }
                }
              ]
            },
            "moss-image": {
              "allOf": [
                {
                  "$ref": "#/$defs/model_settings"
                },
                {
                  "type": "object",
                  "properties": {
                    "target": {
                      "type": "object",
                      "properties": {
                        "family": {
                          "const": "moss-image"
                        }
                      }
                    }
                  }
                }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
