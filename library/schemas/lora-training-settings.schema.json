{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storyvisualizer.local/schemas/lora-training-settings.schema.json",
  "type": "object",
  "required": [
    "version",
    "target",
    "training_recipe",
    "run_defaults"
  ],
  "properties": {
    "version": {
      "const": 5
    },
    "target": {
      "type": "object",
      "required": [
        "family",
        "prompt_family",
        "usage_defaults",
        "base"
      ],
      "properties": {
        "family": {
          "enum": [
            "anima",
            "qwen-image-2-1"
          ]
        },
        "prompt_family": {
          "type": "string",
          "minLength": 1
        },
        "usage_defaults": {
          "$ref": "#/$defs/usage_defaults"
        },
        "base": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "training_recipe": {
      "type": "object",
      "required": [
        "id",
        "overrides"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "overrides": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "run_defaults": {
      "type": "object",
      "required": [
        "max_train_steps",
        "save_every_n_steps",
        "seed"
      ],
      "properties": {
        "max_train_steps": {
          "type": "integer",
          "minimum": 1
        },
        "save_every_n_steps": {
          "type": "integer",
          "minimum": 1
        },
        "seed": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "usage_defaults": {
      "type": "object",
      "required": [
        "clip_skip",
        "sampler",
        "scheduler",
        "steps",
        "cfg"
      ],
      "properties": {
        "clip_skip": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "sampler": {
          "type": "string",
          "minLength": 1
        },
        "scheduler": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "integer",
          "minimum": 1
        },
        "cfg": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "base_dir": {
      "type": "object",
      "required": [
        "relative_path"
      ],
      "properties": {
        "relative_path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\.\\.)(?!.*\\\\).+/$"
        },
        "source": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "recipe_overrides": {
      "type": "object",
      "required": [
        "network_dim",
        "learning_rate",
        "gradient_accumulation_steps"
      ],
      "properties": {
        "network_dim": {
          "type": "integer",
          "minimum": 1
        },
        "learning_rate": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "gradient_accumulation_steps": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "qwen_base": {
      "type": "object",
      "required": [
        "dit",
        "text_encoder",
        "vae",
        "processor"
      ],
      "properties": {
        "dit": {
          "$ref": "#/$defs/base_dir"
        },
        "text_encoder": {
          "$ref": "#/$defs/base_dir"
        },
        "vae": {
          "$ref": "#/$defs/base_dir"
        },
        "processor": {
          "$ref": "#/$defs/base_dir"
        }
      },
      "additionalProperties": false
    },
    "anima_base": {
      "type": "object",
      "required": [
        "dit",
        "text_encoder",
        "vae"
      ],
      "properties": {
        "dit": {
          "$ref": "#/$defs/base_file"
        },
        "text_encoder": {
          "$ref": "#/$defs/base_file"
        },
        "vae": {
          "$ref": "#/$defs/base_file"
        }
      },
      "additionalProperties": false
    },
    "base_file": {
      "type": "object",
      "required": [
        "relative_path"
      ],
      "properties": {
        "relative_path": {
          "type": "string",
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\.\\.)(?!.*\\\\).+\\.safetensors$"
        },
        "source": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "anima_recipe_overrides": {
      "type": "object",
      "required": [
        "network_dim",
        "learning_rate",
        "gradient_accumulation_steps",
        "micro_batch_size",
        "blocks_to_swap"
      ],
      "properties": {
        "network_dim": {
          "type": "integer",
          "minimum": 1
        },
        "learning_rate": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "gradient_accumulation_steps": {
          "type": "integer",
          "minimum": 1
        },
        "micro_batch_size": {
          "type": "integer",
          "minimum": 1
        },
        "blocks_to_swap": {
          "type": "integer",
          "minimum": 0,
          "maximum": 27
        }
      },
      "additionalProperties": false
    }
  },
  "title": "训练项目当前设置",
  "allOf": [
    {
      "if": {
        "properties": {
          "target": {
            "properties": {
              "family": {
                "const": "anima"
              }
            },
            "required": [
              "family"
            ],
            "type": "object"
          }
        },
        "required": [
          "target"
        ],
        "type": "object"
      },
      "then": {
        "properties": {
          "target": {
            "properties": {
              "base": {
                "$ref": "#/$defs/anima_base"
              }
            },
            "type": "object"
          },
          "training_recipe": {
            "properties": {
              "overrides": {
                "$ref": "#/$defs/anima_recipe_overrides"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "target": {
            "properties": {
              "family": {
                "const": "qwen-image-2-1"
              }
            },
            "required": [
              "family"
            ],
            "type": "object"
          }
        },
        "required": [
          "target"
        ],
        "type": "object"
      },
      "then": {
        "properties": {
          "target": {
            "properties": {
              "base": {
                "$ref": "#/$defs/qwen_base"
              }
            },
            "type": "object"
          },
          "training_recipe": {
            "properties": {
              "overrides": {
                "$ref": "#/$defs/recipe_overrides"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    }
  ]
}
