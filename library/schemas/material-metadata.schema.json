{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storyvisualizer.local/schemas/material-metadata.schema.json",
  "type": "object",
  "required": ["items"],
  "properties": {
    "$schema": { "type": "string" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "file"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "file": { "type": "string", "minLength": 1, "pattern": "^[^/\\\\]+$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
