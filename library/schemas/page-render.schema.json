{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storyvisualizer.local/schemas/page-render.schema.json",
  "type": "object",
  "required": [
    "version",
    "model_id",
    "profile_id",
    "canvas"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "model_id": {
      "enum": [
        "anima",
        "qwen",
        "h3"
      ]
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "canvas": {
      "enum": [
        "3:4",
        "1:1",
        "4:3",
        "2:3",
        "9:16"
      ]
    }
  },
  "additionalProperties": false
}
