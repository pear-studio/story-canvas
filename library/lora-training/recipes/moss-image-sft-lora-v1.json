{
  "id": "moss-image-sft-lora-v1",
  "version": 1,
  "name": "MOSS SFT BF16 LoRA",
  "family": "moss-image",
  "description": "MOSS SFT BF16 底模、FP32 LoRA/AdamW；固定 DiffSynth commit 的 262 个自动探测 Linear 展开为显式目标，activation CPU offload。生成使用 INT8；此训练路线不提供精确续训。",
  "semantic_config": {
    "max_pixels": 1048576,
    "network_dim": 32,
    "network_alpha": 32,
    "learning_rate": 0.0001,
    "gradient_accumulation_steps": 1,
    "micro_batch_size": 1,
    "optimizer": {
      "type": "AdamW",
      "betas": [
        0.9,
        0.999
      ],
      "eps": 1e-8,
      "weight_decay": 0.01
    },
    "scheduler": {
      "type": "ConstantLR",
      "factor": 0.3333333333333333,
      "total_iters": 5
    },
    "precision": {
      "base": "bf16",
      "lora": "fp32",
      "optimizer_state": "fp32"
    },
    "gradient_checkpointing": true,
    "activation_cpu_offload": true,
